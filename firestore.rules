rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isRoomMember(roomCode) {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/rooms/$(roomCode)/players/$(request.auth.uid)
        );
    }

    // Room docs are readable by authenticated users.
    // Writes are Cloud Functions only (Admin SDK bypasses rules).
    match /rooms/{roomCode} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Player docs are only readable by members of the same room.
    // Writes are Cloud Functions only (Admin SDK bypasses rules).
    match /rooms/{roomCode}/players/{playerId} {
      allow read: if isRoomMember(roomCode);
      allow write: if false;
    }

    // Deny everything else by default until future increments add scoped rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
